    "# Remove constant columns\n",
    "vif_df = vif_df.loc[:, vif_df.nunique() > 1]\n",
    "\n",
    "# Remove infinite and missing values\n",
    "vif_df = vif_df.replace([np.inf, -np.inf], np.nan)\n",
