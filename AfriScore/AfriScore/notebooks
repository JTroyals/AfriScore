    "# ==========================================\n",
    "# CORRELATION ANALYSIS - MASTER DATASET\n",
    "# ==========================================\n",
    "\n",
    "import pandas as pd\n",
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "import seaborn as sns\n",
    "\n",
    "# copy so the original dataset remains unchanged\n",
    "corr_df = master_df.copy()\n",
    "\n",
    "# 1. Convert target variable into numerical values\n",
    "corr_df['good_bad_flag'] = (\n",
    "    corr_df['good_bad_flag']\n",
    "    .astype(str).str.strip().str.lower()\n",
    "    .map({'good': 1, 'bad': 0})\n",
    ")\n",
    "\n",
    "# Check target conversion\n",
    "print(\"TARGET VARIABLE DISTRIBUTION:\")\n",
    "print(corr_df['good_bad_flag'].value_counts(dropna=False))\n",
    "\n",
    "# 2. Remove identifiers that should not be used\n",
    "id_cols = [\n",
    "    'customerid',\n",
    "    'systemloanid',\n",
    "    'loannumber',\n",
    "    'referredby'\n",
    "]\n",
    "\n",
    "corr_df.drop(\n",
    "    columns=[c for c in id_cols if c in corr_df.columns],\n",
    "    inplace=True\n",
    ")\n",
    "\n",
    "# 3. Convert date columns into useful numerical features\n",
    "date_cols = ['approveddate', 'creationdate']\n",
    "\n",
    "for col in date_cols:\n",
    "    if col in corr_df.columns:\n",
    "        corr_df[col] = pd.to_datetime(\n",
    "            corr_df[col], errors='coerce'\n",
    "        )\n",
    "\n",
    "if 'birthdate' in corr_df.columns:\n",
    "    corr_df['birthdate'] = pd.to_datetime(\n",
    "        corr_df['birthdate'], errors='coerce'\n",
    "    )\n",
    "\n",
    "    if 'approveddate' in corr_df.columns:\n",
    "        corr_df['age_at_approval'] = (\n",
    "            (corr_df['approveddate'] - corr_df['birthdate'])\n",
    "            .dt.days / 365.25\n",
    "        )\n",
    "\n",
    "    corr_df.drop(columns=['birthdate'], inplace=True)\n",
    "\n",
    "if all(c in corr_df.columns for c in date_cols):\n",
    "    corr_df['application_processing_days'] = (\n",
    "        corr_df['approveddate'] - corr_df['creationdate']\n",
    "    ).dt.days\n",
    "\n",
    "# Remove raw dates after feature extraction\n",
    "corr_df.drop(\n",
    "    columns=[c for c in date_cols if c in corr_df.columns],\n",
    "    inplace=True\n",
    ")\n",
    "\n",
    "# 4. Separate target from other variables\n",
    "target = 'good_bad_flag'\n",
    "\n",
    "# Remove rows where target is missing\n",
    "corr_df = corr_df.dropna(subset=[target])\n",
    "\n",
    "# 5. Convert categorical variables using One-Hot Encoding\n",
    "X = corr_df.drop(columns=[target])\n",
    "\n",
    "X = pd.get_dummies(\n",
    "    X,\n",
    "    drop_first=True,\n",
    "    dtype=int\n",
    ")\n",
    "\n",
    "# 6. Combine predictors and target\n",
    "analysis_df = X.copy()\n",
    "analysis_df[target] = corr_df[target]\n",
    "\n",
    "# Replace infinite values\n",
    "analysis_df = analysis_df.replace(\n",
    "    [np.inf, -np.inf], np.nan\n",
    ")\n",
    "\n",
    "# 7. Calculate correlation matrix\n",
    "correlation_matrix = analysis_df.corr(\n",
    "    method='pearson'\n",
    ")\n",
    "\n",
    "# 8. Display correlation of every variable with target\n",
    "target_corr = (\n",
    "    correlation_matrix[target]\n",
    "    .drop(target)\n",
    "    .sort_values(ascending=False)\n",
    ")\n",
    "\n",
    "print(\"\\nCORRELATION WITH LOAN PERFORMANCE:\")\n",
    "print(target_corr.to_string())\n",
    "\n",
    "# 9. Visualize target correlations\n",
    "plt.figure(figsize=(10, max(6, len(target_corr) * 0.3)))\n",
    "\n",
    "sns.barplot(\n",
    "    x=target_corr.values,\n",
    "    y=target_corr.index\n",
    ")\n",
    "\n",
    "plt.axvline(0, color='black', linewidth=0.8)\n",
    "plt.title('Correlation of All Variables with Loan Performance')\n",
    "plt.xlabel('Pearson Correlation')\n",
    "plt.ylabel('Variables')\n",
    "plt.tight_layout()\n",
    "plt.show()\n",
    "\n",
    "# 10. Display the full correlation matrix\n",
    "print(\"\\nFULL CORRELATION MATRIX:\")\n",
    "display(correlation_matrix)"
   ]
